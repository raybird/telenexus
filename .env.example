TELEGRAM_TOKEN=your_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here
DB_DIR=./data

# === 容器執行身分 (可攜性) ===
# 對齊 host 帳號的 UID/GID,讓 bind mount 寫出的檔案 owner 正確、免手動 chown。
# 執行 ./setup.sh 會自動以 `id -u` / `id -g` 填好這兩項;預設 1000。
PUID=1000
PGID=1000

# === Runner 配置 (雙服務架構標準配置) ===
RUNNER_ENDPOINT=http://agent-runner:8787
# 排程任務是否使用 runner 執行 (預設: true)
SCHEDULE_USE_RUNNER=true
# 聊天訊息使用 runner 的百分比 0-100 (預設: 100,全部走 runner)
CHAT_USE_RUNNER_PERCENT=100
# 限定使用 runner 的使用者 ID (逗號分隔,留空則使用 ALLOWED_USER_ID)
CHAT_USE_RUNNER_ONLY_USERS=your_telegram_user_id_here

# === Runner 安全性 ===
# Runner API 的共享密鑰 (建議設定強密碼)
RUNNER_SHARED_SECRET=change_this_to_a_long_random_secret

# === Runner 熔斷機制 ===
# 連續失敗幾次後觸發熔斷 (預設: 3)
RUNNER_FAILURE_THRESHOLD=3
# 熔斷冷卻時間 (毫秒,預設: 60000 = 1分鐘)
RUNNER_COOLDOWN_MS=60000

# Runner HTTP 請求逾時 (毫秒,預設: 1900000 ≈ 31 分鐘)
RUNNER_REQUEST_TIMEOUT_MS=1900000

# === AI 執行逾時 ===
# Opencode CLI 子程序最長執行時間,含串流模式 (毫秒,預設: 1800000 = 30 分鐘)
OPENCODE_TASK_TIMEOUT_MS=1800000

# === 排程任務逾時保險 ===
# Scheduler 單一任務最長執行時間 (毫秒,預設: 900000 = 15 分鐘)
# 防止下游任何一層卡死導致排程主迴圈無限期阻塞
SCHEDULE_TASK_TIMEOUT_MS=900000

# === 錯誤告警 (推送至 ALLOWED_USER_ID) ===
# 同 scope 在 ERROR_ALERT_WINDOW_MS 內出現 N 次即觸發 Telegram 推送 (預設: 3)
ERROR_ALERT_THRESHOLD=3
# 滑動視窗長度 (毫秒,預設: 600000 = 10 分鐘)
ERROR_ALERT_WINDOW_MS=600000
# 同 scope 至少冷卻 N 毫秒才能再次告警 (預設: 1800000 = 30 分鐘)
ERROR_ALERT_COOLDOWN_MS=1800000

# === 模型健康檢查 (推送至 ALLOWED_USER_ID) ===
# 週期性確認生效模型是否仍可呼叫。上游下架模型時,原本要等排程一輪輪靜默失敗才會發現。
# 注意 opencode models 清單仍會列出已 EOL 的模型,因此只能靠實際呼叫判斷。
MODEL_HEALTH_CHECK_ENABLED=true
# 檢查週期 (毫秒,預設: 3600000 = 1 小時)
# 週期內若已有真實成功呼叫則自動跳過,不額外消耗配額。
MODEL_HEALTH_CHECK_INTERVAL_MS=3600000
# 單次檢查逾時 (毫秒,預設: 120000 = 2 分鐘)
# 實測健康模型約需 11 秒回應,設太短會把好模型誤報成故障。
MODEL_HEALTH_CHECK_TIMEOUT_MS=120000
# 故障持續期間,每隔 N 毫秒推一則「仍未恢復」提醒 (預設: 21600000 = 6 小時)
# 同一故障不會每個週期都推播;錯誤性質改變或恢復時則會立刻通知。
MODEL_HEALTH_REMIND_MS=21600000

# Context snapshots
CONTEXT_REFRESH_MS=60000

# Telegram throttled streaming
TELEGRAM_STREAMING_ENABLED=false
TELEGRAM_STREAM_EDIT_THROTTLE_MS=1200
TELEGRAM_STREAM_MIN_DELTA_CHARS=60
TELEGRAM_STREAM_FORCE_FLUSH_MS=3000
TELEGRAM_STREAM_EARLY_FLUSH_CHARS=180
TELEGRAM_STREAM_MAX_EDIT_FAILURES=3
# Telegram 私聊原生 draft 的保活更新，以及聊天室 typing 狀態更新間隔。
TELEGRAM_STREAM_DRAFT_REFRESH_MS=20000
TELEGRAM_STREAM_TYPING_REFRESH_MS=4000
# 純 thinking 模式（預設 true）：等待期間只把模型 reasoning 即時更新到占位訊息，
# 答案不漸進顯示；拿到結果時移除 thinking、只留最終答案。設 false 則回到「答案漸進串流」。
TELEGRAM_STREAM_REASONING_MODE=true
TELEGRAM_STREAM_REASONING_THROTTLE_MS=1500
# 完成時刪除占位（思考中）訊息、改發一則全新的最終答案，讓最終訊息帶「完成當下」時間戳，
# 方便看出整體耗時（預設跟隨 TELEGRAM_STREAM_REASONING_MODE）。設 false 則維持原地編輯占位訊息。
TELEGRAM_STREAM_FINALIZE_NEW_MESSAGE=true

# Local Web Console
WEB_ENABLED=true
WEB_BIND=0.0.0.0
WEB_PORT=3030
WEB_AUTH_TOKEN=
WEB_TRUST_PRIVATE_NETWORK=true
WEB_ALERT_ERROR_THRESHOLD=1
WEB_ALERT_RUNNER_SUCCESS_WARN_THRESHOLD=80
WEB_USER_ID=

# Runner observability (optional overrides)
RUNNER_AUDIT_PATH=
RUNNER_STATUS_PATH=

# Memoria auto-sync (optional)
# sync 走 HTTP POST /v1/remember 到 MEMORIA_ENDPOINT (與 recall 同一個 memoria 服務);
# 不再 spawn 本地 CLI,故無 MEMORIA_HOME / MEMORIA_CLI_PATH。
MEMORIA_SYNC_ENABLED=auto
# 預設為 hook-free；只有需要相容舊 hook queue 流程時再開
MEMORIA_HOOK_QUEUE_ENABLED=false
MEMORIA_SYNC_TIMEOUT_MS=20000
MEMORIA_HOOK_QUEUE_POLL_MS=5000
# MEMORIA_HOOK_QUEUE_FILE=/app/data/memoria-hook-queue.jsonl
# MEMORIA_HOOK_FLUSH_SIGNAL=/app/data/memoria-hook-flush.signal
# 選用:把 memoria volume 唯讀掛進 telenexus 後,讓 memory backfill 直接讀 archive DB
# MEMORIA_ARCHIVE_DB=/app/memoria-archive/.memory/sessions.db

# Memoria recall (語意摘要讀回路，需啟動 memoria 服務)
# auto = 有設 MEMORIA_ENDPOINT 就啟用；on/off 強制開關
MEMORIA_RECALL_ENABLED=auto
# Docker Compose 內預設指向 memoria 服務；單機測試可改 http://localhost:3917
MEMORIA_ENDPOINT=http://memoria:3917
MEMORIA_RECALL_TIMEOUT_MS=1500
MEMORIA_RECALL_TOP_K=5

# Memory backfill (recommended: enable dry-run first)
MEMORY_BACKFILL_ENABLED=false
MEMORY_BACKFILL_DRY_RUN=true
# MEMORY_BACKFILL_INTERVAL_MS=300000
# MEMORY_BACKFILL_STARTUP_DELAY_MS=15000
# MEMORY_BACKFILL_BATCH_SIZE=50
# MEMORY_BACKFILL_MAX_CANDIDATES_PER_RUN=20
# MEMORY_BACKFILL_CHECKPOINT_FILE=/app/data/memory-backfill-checkpoint.json

OPENCODE_VERBOSE_STDERR=true